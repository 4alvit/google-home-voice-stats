{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "urls",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_urls.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/urls",
      "instrumentation": [
        {
          "module": "igw_google_voice.__main__",
          "functions": [
            "validate_url",
            "local_http_host"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "fuzz",
    "igw_google_voice",
    "pyproject.toml",
    "requirements-cast.lock",
    "requirements-kitten-macos-intel.lock",
    "requirements-kitten-package.lock",
    "requirements-kitten.lock",
    "requirements-piper.lock",
    "requirements-test.lock",
    "requirements-tls.in",
    "requirements-tls.lock"
  ]
}
