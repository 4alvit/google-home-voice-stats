{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pip_requirements",
    "pip-compile"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      ".github/requirements-security.txt",
      "requirements-kitten-macos-intel.lock",
      "requirements-kitten-package.lock",
      "requirements-russian-silero.lock",
      ".github/requirements-build.txt",
      "requirements-cast.lock",
      "requirements-kitten.lock",
      "requirements-piper.lock",
      "requirements-russian-kitten.lock",
      "requirements-russian-piper.lock",
      "requirements-test.lock",
      "requirements-tls.lock",
      ".github/requirements-build.in",
      ".github/requirements-wheels-only.in",
      "pyproject.toml",
      "requirements-kitten.in",
      "requirements-russian-kitten.in",
      "requirements-russian-piper.in",
      "requirements-tls.in"
    ]
  },
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    ".github/requirements-security.txt",
    "requirements-kitten-macos-intel.lock",
    "requirements-kitten-package.lock",
    "requirements-russian-silero.lock"
  ],
  "packageRules": [
    {
      "description": "Generated locks with unsupported compile flags or export headers are regenerated through their existing source workflow.",
      "matchFileNames": [
        ".github/requirements-security.txt"
      ],
      "enabled": false,
      "matchManagers": [
        "pip_requirements"
      ]
    },
    {
      "description": "Piper ONNX Runtime has no Python 3.15 wheels; preserve the existing Docker version hold.",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-build\\.txt$/",
      "/^requirements\\-cast\\.lock$/",
      "/^requirements\\-kitten\\.lock$/",
      "/^requirements\\-piper\\.lock$/",
      "/^requirements\\-russian\\-kitten\\.lock$/",
      "/^requirements\\-russian\\-piper\\.lock$/",
      "/^requirements\\-test\\.lock$/",
      "/^requirements\\-tls\\.lock$/"
    ]
  }
}
